# Copy this file to ".env" and change the values if needed.
# Command Prompt:  copy .env.example .env

# Port where the website runs  ->  http://localhost:3000
PORT=3000

# MongoDB connection string. The database name is the last part: student_portal
# (127.0.0.1 is used instead of "localhost" to avoid a common Windows connection problem)
MONGODB_URI=mongodb://127.0.0.1:27017/student_portal
