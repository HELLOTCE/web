# Copy this file to ".env" and change the values if needed.
# Command Prompt:  copy .env.example .env

# Port where the website runs  ->  http://localhost:3000
PORT=3000

# MongoDB Atlas connection string. Replace the placeholders with your Atlas values.
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/student_portal?retryWrites=true&w=majority
